{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.9.865"}

        ;; yggdrasil — HLC-coordinated multi-store versioning (snapshot/branch/merge).
        org.replikativ/yggdrasil {:mvn/version "0.3.40"}

        ;; Storage backends the adapters wrap. Published coords (no forks) so the
        ;; jar resolves standalone; a host may override datalevin with a fork.
        org.replikativ/datahike {:mvn/version "0.8.1788"}
        datalevin/datalevin {:mvn/version "1.0.2"}
        org.replikativ/proximum {:mvn/version "0.1.35"}
        org.replikativ/konserve {:mvn/version "0.9.375"}

        ;; hive-dsl — Result/rescue DSL (workspace late-bind seam).
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.14"}

        ;; malli — value-object schemas at the coordination seams (schema ns).
        metosin/malli {:mvn/version "0.20.1"}

        com.taoensso/timbre {:mvn/version "6.8.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; Malli regex-schema generators (Sha256 fixtures).
                       com.gfredericks/test.chuck {:mvn/version "0.2.15"}
                       ;; schema-driven free coverage: a malli schema drives
                       ;; property + mutation facets with no hand-written
                       ;; generator/oracle/mutant (hive-schemas.test).
                       io.github.hive-agi/hive-test    {:mvn/version "0.3.12"}
                       io.github.hive-agi/hive-schemas {:mvn/version "0.1.13"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test
         :jvm-opts ["--add-modules=jdk.incubator.vector"]}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.8"}}
   :ns-default hive-build.api}
  :dev {:jvm-opts ["--add-modules=jdk.incubator.vector"]}}}
